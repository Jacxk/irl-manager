# Copy to .env. Generate unique secrets with: openssl rand -hex 32
DATABASE_URL=postgres://irl:CHANGE_ME@localhost:5432/irl
POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MEDIA_WORKER_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Add a media node in the app, then paste its UUID here.
MEDIA_SERVER_ID=
MEDIA_INTERNAL_HOST=localhost
MEDIA_HLS_URL=http://localhost:8888

# Lock UI settings only when their environment variable is explicitly supplied.
LOCK_BY_ENVIRONMENT=false
